rules_version = '2';
// Regras do banco – Baixa de Torque CWA 12
// Só quem tem login (criado por você no Firebase Authentication) lê e grava.
// Desfazer baixa: quem lançou ou um administrador (coleção "admins", documento com o UID do usuário).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function admin() { return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /baixas/{item} {
      allow read: if logado();
      allow create, update: if logado()
        && request.resource.data.item is int
        && request.resource.data.por == request.auth.token.email;
      allow delete: if admin() || (logado() && resource.data.por == request.auth.token.email);
    }
    match /historico/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.por == request.auth.token.email;
      allow update, delete: if false;      // histórico não se apaga
    }
    match /config/{doc} {
      allow read: if logado();
      allow write: if admin();             // torquímetros: só administrador altera
    }
    match /usuarios/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;
    }
    match /admins/{uid} {
      allow read: if logado();
      allow write: if false;               // cadastre administradores pelo Console
    }
  }
}
